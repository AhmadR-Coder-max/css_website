<!-- Registration Modal -->
<div id="registration-modal" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
  <div class="bg-white rounded-2xl shadow-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto">
    <div class="sticky top-0 bg-gradient-to-r from-[#003366] to-blue-500 text-white p-6 rounded-t-2xl flex justify-between items-center">
