            </div>
            
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-8 h-8 bg-gradient-to-br from-[#003366] to-blue-500 rounded-lg flex items-center justify-center">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
              </div>
              <p class="text-gray-700 pt-0.5">Build a supportive and inclusive community</p>
            </div>
            
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-8 h-8 bg-gradient-to-br from-[#003366] to-blue-500 rounded-lg flex items-center justify-center">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
              </div>
              <p class="text-gray-700 pt-0.5">Connect students with industry opportunities</p>
            </div>
            
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-8 h-8 bg-gradient-to-br from-[#003366] to-blue-500 rounded-lg flex items-center justify-center">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
              </div>
              <p class="text-gray-700 pt-0.5">Promote lifelong learning and professional growth</p>
            </div>
          </div>
        </div>
        
        <!-- Image/Illustration Side -->
        <div class="w-full lg:w-1/2">
          <div class="relative">
            <!-- Decorative background -->
            <%= image_tag "no-bg-logo.png", class: "relative rounded-2xl shadow-2xl w-full h-auto" %>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Core Values (Optional) -->
    <div>
