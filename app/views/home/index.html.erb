<!-- Background container with gradient mesh -->
<div class="relative w-full bg-white overflow-hidden">
  <!-- Animated gradient background -->
  <div class="absolute inset-0 bg-gradient-to-br from-blue-50 via-indigo-50 to-purple-50">
    <!-- Top left gradient orb -->
    <div class="absolute -top-40 -left-40 w-96 h-96 bg-gradient-to-br from-blue-400/30 to-indigo-500/30 rounded-full blur-3xl"></div>
    
    <!-- Top right gradient orb -->
    <div class="absolute -top-20 -right-20 w-80 h-80 bg-gradient-to-br from-purple-400/20 to-pink-400/20 rounded-full blur-3xl"></div>
    
    <!-- Bottom left gradient orb -->
    <div class="absolute -bottom-32 -left-32 w-96 h-96 bg-gradient-to-tr from-indigo-400/25 to-blue-500/25 rounded-full blur-3xl"></div>
    
    <!-- Bottom right gradient orb -->
    <div class="absolute bottom-0 right-0 w-[600px] h-[600px] bg-gradient-to-tl from-[#003366]/15 to-transparent rounded-full blur-3xl"></div>
    
    <!-- Center accent -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-gradient-to-br from-blue-300/10 via-indigo-300/10 to-purple-300/10 rounded-full blur-3xl"></div>
  </div>
  
  <!-- Subtle grid overlay for texture -->
  <div class="absolute inset-0 bg-grid-slate-100 [mask-image:linear-gradient(0deg,white,rgba(255,255,255,0.6))] bg-[length:80px_80px]"></div>
  
  <!-- Content section -->
  <section class="relative max-w-screen-xl mx-auto p-4 flex justify-between items-center w-full min-h-[97vh] px-8 lg:px-16 py-16">
    <div class="w-full lg:w-1/2 pr-0 lg:pr-20 mb-12 lg:mb-0">
      <p class="text-3xl lg:text-4xl text-gray-900 font-bold mb-6 leading-tight">
        Welcome to the Computer Science Society (CSS)
      </p>
      <p class="text-base text-gray-600 leading-relaxed">
        We are a student-led community at GCU, dedicated to exploring innovation, technology, and collaboration in the field of computer science.
        We are a student-led community at GCU, dedicated to exploring innovation, technology, and collaboration in the field of computer science.
        We are a student-led community at GCU, dedicated to exploring innovation, technology, and collaboration in the field of computer science.
      </p>
      <div class="mt-5">
        <a href="/about_us" class="bg-[#003366] text-white px-4 py-2 rounded"> Learn More </a>
      </div>
    </div>    
    
    <div class="w-full lg:w-1/2 flex justify-center lg:justify-end">
      <%= image_tag "no-bg-logo.png", class: "w-full max-w-md h-auto drop-shadow-2xl" %>
    </div>
  </section>
</div>

<!-- About / Our Mission Section -->
<div class="relative bg-white overflow-hidden">
  <!-- Gradient background -->
  <div class="absolute inset-0 bg-gradient-to-b from-white via-slate-50 to-blue-50/30">
    <!-- Top gradient orb -->
    
    <!-- Center left accent -->
    <div class="absolute top-1/2 -left-48 w-[500px] h-[500px] bg-[#003366]/8 rounded-full"></div>
    
    <!-- Bottom right accent -->
    <div class="absolute -bottom-32 right-0 w-[600px] h-[600px] bg-gradient-to-tl from-blue-300/20 to-transparent rounded-full"></div>
  </div>
  
  <!-- Content -->
  <section class="relative px-8 lg:px-16 py-20 lg:py-32 max-w-7xl mx-auto">
    
    <!-- About Us -->
    <div class="mb-24">
      <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-20">
        <!-- Image/Illustration Side -->
        <div class="w-full lg:w-1/2 order-2 lg:order-1">
          <div class="relative">
            <!-- Decorative background -->
            <%= image_tag "no-bg-logo.png", class: "relative rounded-2xl shadow-2xl w-full h-auto" %>
          </div>
        </div>
        
        <!-- Text Content -->
        <div class="w-full lg:w-1/2 order-1 lg:order-2">
          <h2 class="text-4xl lg:text-5xl font-bold text-gray-900 mb-6">
            About Us
          </h2>
          <div class="h-1 w-20 bg-gradient-to-r from-[#003366] to-blue-400 rounded-full mb-8"></div>
          <p class="text-lg text-gray-600 leading-relaxed mb-6">
            The Computer Science Society (CSS) at GCU is more than just a club—it's a vibrant community where students passionate about technology come together to learn, innovate, and grow.
          </p>
          <p class="text-lg text-gray-600 leading-relaxed mb-6">
            Founded by students, for students, we bridge the gap between academic learning and real-world application. Whether you're a beginner taking your first steps in coding or an experienced developer looking to collaborate on cutting-edge projects, CSS is your home.
          </p>
          <p class="text-lg text-gray-600 leading-relaxed">
            Through workshops, hackathons, guest lectures, and networking events, we empower our members to explore their potential and make meaningful connections in the tech industry.
          </p>
        </div>
      </div>
    </div>
    
    <!-- Our Mission -->
    <div class="mb-24">
      <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-20">
        <!-- Text Content -->
